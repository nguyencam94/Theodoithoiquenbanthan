rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: /users/{userId}
    // Fields:
    //   - uid: string (required)
    //   - email: string (required)
    //   - displayName: string
    //   - photoURL: string
    //   - role: string (user/admin)
    //   - categories: list
    //   - categoryIcons: map
    //   - categoryColors: map
    //
    // Collection: /users/{userId}/habits/{habitId}
    // Fields:
    //   - id: string (required)
    //   - userId: string (required)
    //   - name: string (required)
    //   - category: string (required)
    //   - iconName: string
    //   - completedDays: list
    //   - logs: map
    //   - color: string
    //   - targetCount: number
    //   - createdAt: timestamp
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "nguyencam94@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string &&
             data.email is string &&
             (!('role' in data) || data.role in ['user', 'admin']);
    }

    function isValidHabit(data) {
      return data.keys().hasAll(['id', 'userId', 'name', 'category']) &&
             data.id is string &&
             data.userId is string &&
             data.name is string && data.name.size() > 0 && data.name.size() < 200 &&
             data.category is string &&
             (!('completedDays' in data) || data.completedDays is list) &&
             (!('logs' in data) || data.logs is map) &&
             (!('targetCount' in data) || data.targetCount is number);
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data) && 
                      (!('role' in request.resource.data) || request.resource.data.role == 'user' || isAdmin());
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                      (request.resource.data.role == resource.data.role || isAdmin());

      match /habits/{habitId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidHabit(request.resource.data) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidHabit(request.resource.data) && request.resource.data.userId == userId;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
